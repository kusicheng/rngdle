DirectoryIndex index.html
Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Never serve hidden configuration, database files, credentials, or logs.
<FilesMatch "(^\.|\.(sqlite|sqlite3|db|log|key|pem|env)$)">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Use HTTPS on the deployment host; localhost remains available over HTTP.
    RewriteCond %{HTTP_HOST} ^kevincheng\.web\.illinois\.edu$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://kevincheng.web.illinois.edu%{REQUEST_URI} [R=301,L]
    RewriteRule ^(?:lib|cc_mnt|ARCHIVE|rngdle-storage)(?:/|$) - [F,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>
